{
  "name": "coursedu-project",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently --names \"coursedu,group1,group1-api,group2,group2-api,group3,group3-api,group4,group4-api,group5,group5-api\" --prefix-colors \"green,magenta,cyan,purple,gray,red,yellow,orange,brown,blue,white\" \"npm run start:root\" \"npm run start:group1\" \"npm run start:backend\" \"npm run start:group2\" \"npm run start:group2:backend\" \"npm run start:group3\" \"npm run start:group3:backend\" \"npm run start:group4\" \"npm run start:group4:backend\" \"npm run start:group5\" \"npm run start:group5:backend\"",
    "start:root": "expo start --port 8080 --offline",
    "start:group1": "npm run start --prefix group1/app-expo",
    "start:backend": "npm run dev --prefix group1/app-backend",
    "start:group2": "npm run start --prefix group2/client",
    "start:group2:backend": "npm run dev --prefix group2/server",
    "start:group3": "npm run start --prefix group3",
    "start:group3:backend": "npm run dev --prefix group3/backend",
    "start:group4": "npm run start --prefix group4",
    "start:group4:backend": "npm run dev --prefix group4/backend",
    "start:group5": "npm run start --prefix group5/frontend",
    "start:group5:backend": "npm run dev --prefix group5/backend",
    "install:all": "npm install && npm install --prefix group1/app-backend && npm install --prefix group1/app-expo && npm install --prefix group2/client && npm install --prefix group2/server && npm install --prefix group3 && npm install --prefix group3/backend && npm install --prefix group4 && npm install --prefix group4/backend && npm install --prefix group5/frontend && npm install --prefix group5/backend",
    "reset-project": "node ./scripts/reset-project.js",
    "postinstall": "node ./scripts/fix-bin-links.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
